TEAM_ID=REVIVE
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Never commit the generated value.
APP_SECRET=replace-with-at-least-32-random-characters
NOTEVAULT_DB=./data/notevault.db
# Secure cookies are required. localhost is treated as a secure context by
# modern browsers; production deployments must terminate TLS before the app.
COOKIE_SECURE=true
